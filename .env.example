# OmniVoice — ortam değişkenleri şablonu
#
# Bu dosyayı `.env.local` olarak kopyalayıp kendi anahtarlarınızı girin.
# `.env.local` git tarafından yok sayılır; bu şablon dosyası ise commit edilir.
#
#   cp .env.example .env.local

# Groq — konuşmayı metne çevirme (STT). console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — metin işleme / zeka katmanı (LLM). openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Varsayılan modeller
OMNIVOICE_STT_MODEL=whisper-large-v3-turbo
OMNIVOICE_LLM_MODEL=anthropic/claude-3.5-haiku

# Yerel motor sunucusunun portu
OMNIVOICE_ENGINE_PORT=8756

# Aylık harcama uyarı eşiği (ABD doları)
OMNIVOICE_BUDGET_USD=5
